# Non-secret settings only. Credentials belong in macOS Keychain.
#
# Store credentials securely:
#   grow-assistant secrets set
#
# Or migrate from an existing .env:
#   grow-assistant secrets migrate

# Auth mode: "approval" (API key + secret) or "totp" (API key + TOTP code)
GROWW_AUTH_MODE=approval

# Credentials — DO NOT paste here. Use Keychain instead:
# GROWW_API_KEY=       (run: grow-assistant secrets set)
# GROWW_API_SECRET=
# GROWW_ACCESS_TOKEN=
# GROWW_TOTP=

GROWW_API_BASE_URL=https://api.groww.in
GROWW_API_VERSION=1.0

# Portfolio guardrails (percentages)
MAX_SINGLE_STOCK_WEIGHT=15
MAX_SECTOR_WEIGHT=30
MIN_CASH_BUFFER_PERCENT=5
REBALANCE_COOLDOWN_DAYS=30

# Benchmark symbol for comparison (NSE index)
BENCHMARK_SYMBOL=NIFTY
BENCHMARK_EXCHANGE=NSE

# Paths
DATA_DIR=./data
REPORTS_DIR=./reports

# Scheduler (24h format, IST)
SCHEDULE_TIME=18:00
TIMEZONE=Asia/Kolkata

# Groww export files (CSV / XLSX / Numbers via: grow-assistant import FILE)
MUTUAL_FUNDS_PATH=./mutual_funds.json
STOCKS_PATH=./stocks.json

# Price source: yahoo (default, free live prices) or groww
PRICE_SOURCE=yahoo

# Fetch news headlines (true/false)
FETCH_NEWS=true
